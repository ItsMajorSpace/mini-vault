# Copy to .env (never commit .env) and replace every secret, e.g. with `openssl rand -hex 32`.

# Superuser: used by the write API and its migrations.
POSTGRES_PASSWORD=change-me-postgres
# GoTrue's own database role (supabase_auth_admin).
AUTH_DB_PASSWORD=change-me-auth
# PowerSync's replication role (powersync_role).
POWERSYNC_DB_PASSWORD=change-me-powersync

# GoTrue signs access tokens with this (HS256, at least 32 characters); PowerSync and the write API verify them.
JWT_SECRET=change-me-to-a-random-secret-of-32-chars-or-more
# Access token lifetime in seconds. PowerSync rejects tokens that live longer than 24 hours.
JWT_EXPIRY=3600

# The public URL of GoTrue, and the URL its emails link back to.
API_EXTERNAL_URL=http://localhost:9999
SITE_URL=http://localhost:9999
# Local only: accounts are confirmed without an email. Set to false and configure SMTP when deployed.
MAILER_AUTOCONFIRM=true

# Where GoTrue sends emails (password reset codes). Locally the Mailpit container catches them; when deployed,
# remove COMPOSE_PROFILES and set a real SMTP server, user, password and sender address.
COMPOSE_PROFILES=dev
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@example.com
